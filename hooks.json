{
  "loop-limiter": {
    "UserMessage": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/init_or_reset_queue.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command|replace_file_content|write_to_file|multi_replace_file_content|delete_file|view_file|grep_search|list_dir",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/check_pre_tool.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "run_command|replace_file_content|write_to_file|multi_replace_file_content|delete_file|view_file|grep_search|list_dir",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/update_attempts.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python scripts/check_stop_condition.py",
        "timeout": 10
      }
    ]
  }
}
